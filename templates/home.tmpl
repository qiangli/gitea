{{template "base/head" .}}
{{/* ycode customization: marketing/install/license sections with external links removed; Loom workspace UI lives under /explore/repos */}}
<div role="main" aria-label="{{if .IsSigned}}{{ctx.Locale.Tr "dashboard"}}{{else}}{{ctx.Locale.Tr "home_title"}}{{end}}" class="page-content home">
	<div class="tw-mb-8 tw-px-8">
		<div class="center">
			<div class="hero">
				<h1 class="ui icon header title tw-text-balance">
					{{AppName}}
				</h1>
				<h2 class="tw-text-balance">
					<a class="ui large primary button" href="{{AppSubUrl}}/explore/repos">
						{{svg "octicon-repo"}}
						<span class="tw-ml-2">{{ctx.Locale.Tr "explore_title"}}</span>
					</a>
				</h2>
			</div>
		</div>
	</div>
</div>
{{template "base/footer" .}}
